{
  "name": "enadstack/laravel-roles",
  "description": "Reusable user management + roles & permissions starter on spatie/laravel-permission.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.0",
    "spatie/laravel-permission": "^8.0",
    "enadstack/laravel-action-logger": "^1.2"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": { "psr-4": { "Enadstack\\LaravelRoles\\": "src/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "extra": {
    "laravel": { "providers": ["Enadstack\\LaravelRoles\\RolesServiceProvider"] },
    "branch-alias": { "dev-v2": "2.x-dev" }
  },
  "config": { "allow-plugins": { "pestphp/pest-plugin": true, "phpstan/extension-installer": true } },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [{
    "name": "action-logger",
    "type": "path",
    "url": "../laravel-action-logger",
    "options": {
      "symlink": true
    }
  }]
}
